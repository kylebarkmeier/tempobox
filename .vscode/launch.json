{
  "version": "0.2.0",
  "configurations": [
    {
      // Requires the "Android" extension (adelphes.android-dev-ext) and a
      // connected device/emulator. Build first with the "Assemble debug APK" task.
      "name": "Launch TempoBox (Android)",
      "type": "android",
      "request": "launch",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "apkFile": "${workspaceRoot}/app/build/outputs/apk/debug/app-debug.apk",
      "adbPort": 5037,
      "preLaunchTask": "Assemble debug APK"
    },
    {
      // Attach a Java debugger to an already-running app process.
      "name": "Attach to process",
      "type": "android",
      "request": "attach",
      "appSrcRoot": "${workspaceRoot}/app/src/main",
      "adbPort": 5037,
      "processId": "${command:PickAndroidProcess}"
    }
  ]
}
